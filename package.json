{
  "name": "search-system",
  "version": "0.1.0",
  "private": true,
  "description": "Basic e-commerce search & recommendation system (interview design) - Phase 0 skeleton",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
